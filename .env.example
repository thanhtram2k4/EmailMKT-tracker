# Copy to .env.local for local development (`npm run setup:local` does this and generates a secret).
# Never commit real secrets. Staging/production values live in the hosting provider's secret store.

# local | test | staging | production
APP_ENV=local

# Local: embedded Postgres started by `npm run db:start` (port 54321).
DATABASE_URL=postgres://postgres:postgres-local-only@127.0.0.1:54321/emt_dev

APP_BASE_URL=http://localhost:3000

# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters

# Google sign-in (OAuth client of an *Internal* consent screen; scopes openid email profile only).
# Leave empty locally to use the dev sign-in instead. Required for staging/production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Company Workspace domain(s) permitted to sign in (comma separated). Must also be on the staff allowlist.
ALLOWED_EMAIL_DOMAINS=example.com

# Local/test only: sign in as an allowlisted address without Google (link shown on screen, never emailed).
# Rejected at startup when APP_ENV is staging or production.
DEV_LOGIN_ENABLED=true

# Sending safety (see CLAUDE.md "Sending rules"):
#   disabled  - nothing can be sent (default)
#   mock      - in-process fake transport, no network (local/test only)
#   simulator - real provider, SES mailbox-simulator recipients only; needs SEND_AUTHORIZATION_REF
#   allowlist - real provider, TEST_RECIPIENT_ALLOWLIST recipients only; needs SEND_AUTHORIZATION_REF
#   live      - production only; customer campaigns additionally need the admin toggle + per-campaign approval
# M5: campaigns use the same guard. Outside production a campaign message is an integration test: mock, or
# SES simulator / allowlisted recipients only. Real customer campaigns need production + live + the admin toggle.
# Test sends accept only addresses on TEST_RECIPIENT_ALLOWLIST (or SES simulator addresses), in every mode.
SEND_MODE=disabled
TEST_RECIPIENT_ALLOWLIST=
SEND_AUTHORIZATION_REF=

# Amazon SES v2 (only used when SEND_MODE is simulator, allowlist or live).
# Credentials are NOT set here: the AWS SDK default chain is used, normally AWS_PROFILE pointing at a
# profile in ~/.aws/credentials (outside this repository). Never commit or paste AWS keys.
SES_REGION=ap-southeast-1
# A verified SES identity, e.g. "Company <news@mail.company.com>". Required for simulator/allowlist/live.
SES_FROM_ADDRESS=
# Optional configuration set (needed later for Delivery/Bounce events via SNS; those need a public HTTPS endpoint).
SES_CONFIGURATION_SET=
# A timeout is recorded as an UNKNOWN outcome and never retried automatically.
SES_TIMEOUT_MS=10000
# AWS_PROFILE=emt-test
TEST_SEND_MAX_PER_HOUR=10
TEST_SEND_MAX_PER_DAY=50

# M5: public base URL for unsubscribe links (/u/<token>), normally the tracking subdomain. Defaults to APP_BASE_URL.
TRACKING_BASE_URL=
# M5: the only SNS topic whose SES events /api/ses-events accepts. Unset = the endpoint refuses everything (503).
SES_EVENTS_TOPIC_ARN=
# M5, APP_ENV local/test ONLY (refused elsewhere): test hooks used by the local stack and tests.
#   SNS_TEST_PUBLIC_KEY_FILE  public key that replaces the AWS SNS certificate download
#   MOCK_TRANSPORT_LOG        the mock transport appends one JSON line per send call
#   MOCK_SEND_DELAY_MS        artificial delay per mock send
SNS_TEST_PUBLIC_KEY_FILE=
MOCK_TRANSPORT_LOG=
MOCK_SEND_DELAY_MS=0

# Encrypts secrets stored in the database (the Notion token). 32 random bytes, base64url.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required when NOTION_MODE is not disabled, and always in staging/production. Keep it in the host's
# secret store; losing it means re-entering the Notion token. For rotation, move the old key to
# APP_ENCRYPTION_KEY_PREVIOUS (+ _PREVIOUS_ID) and give the new key a new APP_ENCRYPTION_KEY_ID.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_ID=k1

# Notion access (see docs/NOTION_SETUP.md):
#   disabled - no Notion calls (default)
#   mock     - local mock server with SYNTHETIC data (`npm run notion:mock`), loopback URL only
#   live     - real Notion API; requires NOTION_AUTHORIZATION_REF (who approved connecting which database)
# The Notion TOKEN is not an environment variable: an admin enters it once in Settings → Notion, and it
# is stored encrypted. Never put it in this file, in Git, or in chat.
NOTION_MODE=disabled
NOTION_API_BASE_URL=
NOTION_AUTHORIZATION_REF=
NOTION_RATE_LIMIT_RPS=2.5

LOG_LEVEL=info
BUILD_ID=dev
WORKER_CONCURRENCY=2
HEARTBEAT_INTERVAL_MS=15000
HEALTH_MAX_HEARTBEAT_AGE_S=60

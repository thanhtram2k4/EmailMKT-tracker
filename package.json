{
  "name": "email-mkt-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "worker": "tsx src/worker/main.ts",
    "db:start": "tsx scripts/db-local.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "staff:add": "tsx scripts/staff.ts add",
    "staff:list": "tsx scripts/staff.ts list",
    "staff:disable": "tsx scripts/staff.ts disable",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "e2e": "tsx scripts/local-stack.ts --log-dir .local/logs/e2e -- playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "e2e:existing": "playwright test",
    "e2e:mock-send": "tsx scripts/local-stack.ts --send-mode mock --log-dir .local/logs/e2e-mock-send -- playwright test tests/e2e/test-send.spec.ts",
    "e2e:mock-campaign": "tsx scripts/local-stack.ts --send-mode mock --log-dir .local/logs/e2e-mock-campaign -- playwright test tests/e2e/campaign-send.spec.ts tests/e2e/campaign-schedule.spec.ts tests/e2e/campaign-tracking.spec.ts",
    "smoke:mock-send": "tsx scripts/local-stack.ts --send-mode mock --log-dir .local/logs/smoke-mock-send -- tsx scripts/smoke.ts --env local-stack",
    "smoke:local": "tsx scripts/local-stack.ts --log-dir .local/logs/smoke -- tsx scripts/smoke.ts --env local-stack",
    "dev:all": "concurrently -n web,worker -c blue,magenta \"npm:dev\" \"npm:worker\"",
    "seed:fixtures": "tsx scripts/seed-fixtures.ts",
    "playwright:install": "tsx scripts/playwright-install.ts",
    "notion:mock": "tsx scripts/notion-mock/server.ts",
    "notion:mock:ctl": "tsx scripts/notion-mock/ctl.ts",
    "dev:crm": "concurrently -n web,worker,notion-mock -c blue,magenta,green \"npm:dev\" \"npm:worker\" \"npm:notion:mock\"",
    "test:tooling": "vitest run --project tooling"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1167.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-link": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "better-auth": "1.7.20",
    "cheerio": "1.2.0",
    "domhandler": "5.0.3",
    "drizzle-orm": "0.45.4",
    "grapesjs": "0.23.9",
    "grapesjs-preset-newsletter": "1.0.2",
    "graphile-worker": "0.18.0",
    "html-to-text": "10.0.1",
    "htmlparser2": "10.1.0",
    "liquidjs": "10.30.1",
    "lucide-react": "1.72.0",
    "luxon": "3.7.2",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.2",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/html-to-text": "9.0.4",
    "@types/luxon": "3.7.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "concurrently": "10.0.7",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pino-pretty": "13.2.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true,
    "@embedded-postgres/darwin-arm64@17.10.0-beta.17": true,
    "@embedded-postgres/darwin-x64@17.10.0-beta.17": true
  }
}
